# ---------------------------------------------------------------------------
# KasirPro POS (Web + Desktop) — environment variables (CONTOH)
#
# Salin:  cp .env.example .env.local    (lalu isi nilai sebenarnya)
# .env.local TIDAK ikut ke git karena berisi rahasia — JANGAN pernah di-commit.
# ---------------------------------------------------------------------------

# --- Aplikasi ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=KasirPro POS
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Supabase (wajib) -------------------------------------------------------
# WAJIB proyek Supabase yang SAMA dengan KasirPro Portal & Admin Portal.
# Ambil di: Supabase Dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Kunci publik (aman tampil di browser). Nama baru "publishable"; nama lama "anon".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Alias yang juga dibaca kode — isi SALAH SATU saja, jangan dua-duanya:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Supabase (server only — JANGAN pakai prefix NEXT_PUBLIC_) --------------
# Dipakai server route (mis. /api/auth/login) & `npm run check:supabase`.
# ⚠️ Ini kunci service role: bisa melewati RLS. Rahasiakan, jangan taruh di browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Alias yang juga dibaca kode — isi SALAH SATU saja:
# SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Opsional: build BUNDEL OFFLINE desktop ---------------------------------
# Diisi otomatis oleh CI (GitHub Actions). Untuk ekspor lokal:
#   DESKTOP_EXPORT=1 npm run export:desktop
# DESKTOP_EXPORT=1
